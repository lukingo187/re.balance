{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "sc CLI version the sc-contract CI job tests against",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+SC_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["charm.land/**", "github.com/charmbracelet/**"],
      "groupName": "charm"
    },
    {
      "matchDepNames": ["ScalableCapital/scalable-cli"],
      "labels": ["sc-cli"],
      "commitMessageTopic": "sc CLI"
    }
  ]
}
